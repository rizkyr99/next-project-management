# Copy to .env and fill in. Required values are checked at build time
# (production on Vercel) and at server start; see lib/env.ts.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Locally, point this at a Neon DEV branch, never
# at production: E2E tests write data and refuse to run against prod.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# At least 32 chars. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Absolute base URL of the app
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRO_PRICE_ID=price_
# Optional, comma-separated. Old Pro price IDs (e.g. the retired $9 price) whose
# existing subscribers must stay Pro. New checkouts use STRIPE_PRO_PRICE_ID only.
STRIPE_PRO_LEGACY_PRICE_IDS=
STRIPE_BUSINESS_PRICE_ID=price_

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_
# Sender on a domain verified in Resend (Domains → Add domain). Required in
# production. Locally, if unset, it falls back to Resend's test sender, which
# only delivers to the Resend account owner.
EMAIL_FROM="Tide <notifications@tide.example.com>"

# ── Rate limiting (Upstash Redis via the Vercel Marketplace, prefix "KV") ──
# Optional locally: without these, rate limiting falls back to in-memory
# per-process counters (useless on Vercel, where instances don't share memory).
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# Public base URL used in email links. Defaults to BETTER_AUTH_URL.
# NEXT_PUBLIC_APP_URL=https://app.example.com
# Set to 1 to skip env validation (unusual builds only).
# SKIP_ENV_VALIDATION=

# Daily job (/api/cron/daily): due-soon reminders and cleanup. Vercel Cron
# sends it as "Authorization: Bearer <CRON_SECRET>". Generate with:
#   openssl rand -base64 32
CRON_SECRET=

# Where the in-app "Send feedback" messages are emailed (reply goes to the
# sender). Without it, feedback is still saved in the feedback table.
# FEEDBACK_EMAIL=

# Contact address shown on /privacy and /terms.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Cloudflare TURN (Realtime → TURN Server). Relays call video for
# people behind strict firewalls. Without it, calls use public STUN only.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Optional: a PRIVATE Vercel Blob store for uploaded images (Storage → Blob →
# Create, access "Private", connect to the project). Locally, without it,
# uploads are saved under .data/uploads.
# BLOB_READ_WRITE_TOKEN=
